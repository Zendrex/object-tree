{
	"name": "@zendrex/object-tree",
	"version": "0.2.2",
	"description": "A library for rendering objects as colorized tree structures in the console.",
	"author": "zendrex",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check": "bunx ultracite check",
		"fix": "bunx ultracite fix",
		"check-types": "tsc -b",
		"changeset": "changeset",
		"version": "changeset version",
		"prepare": "lefthook install",
		"clean": "git clean -xdf dist node_modules"
	},
	"dependencies": {
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@changesets/changelog-github": "^0.6.0",
		"@changesets/cli": "^2.30.0",
		"@swc/core": "^1.15.21",
		"@types/bun": "latest",
		"bun-types": "latest",
		"lefthook": "^2.0.0",
		"tsdown": "^0.21.7",
		"typescript": "^6.0.2",
		"ultracite": "^7.4.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Zendrex/object-tree.git"
	},
	"bugs": {
		"url": "https://github.com/Zendrex/object-tree/issues"
	},
	"homepage": "https://github.com/Zendrex/object-tree#readme",
	"keywords": [
		"typescript",
		"object",
		"tree",
		"console",
		"debug"
	]
}
